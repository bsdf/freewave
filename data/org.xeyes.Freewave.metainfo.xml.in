      <caption>An album with its track list</caption>
      <image type="source" width="1552" height="1012">https://raw.githubusercontent.com/bsdf/freewave/main/data/screenshots/album.png</image>
    </screenshot>
    <screenshot>
      <caption>Now Playing, with a backdrop drawn from the cover's colors</caption>
      <image type="source" width="1552" height="1012">https://raw.githubusercontent.com/bsdf/freewave/main/data/screenshots/nowplaying.png</image>
    </screenshot>
